{
  "info": {
    "_postman_id": "ef9e87ea-5298-4f37-b17a-da5985fcf659",
    "name": "Smart Urban Council API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\",\n  \"displayName\": \"Phase 6 Citizen\",\n  \"phoneNumber\": \"+94770000000\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.data.tokens.accessToken);",
                  "pm.environment.set('refresh_token', body.data.tokens.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "Refresh Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.data.tokens.accessToken);",
                  "pm.environment.set('refresh_token', body.data.tokens.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Reject Privileged Public Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attacker@example.com\",\n  \"password\": \"SecurePassword123\",\n  \"displayName\": \"Invalid Actor\",\n  \"role\": \"ADMINISTRATOR\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Reject Unauthenticated Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Department Management",
      "item": [
        {
          "name": "Administrator Login",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.data.user.role).to.eql('ADMINISTRATOR');",
              "pm.environment.set('admin_access_token', body.data.tokens.accessToken);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "List Departments",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Departments are returned', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().data.departments;",
              "const planning = items.find((item) => item.code === 'PLANNING');",
              "if (planning) pm.environment.set('department_id', planning.id);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": "{{base_url}}/api/v1/admin/departments"
          }
        },
        {
          "name": "List Categories",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Categories are returned', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().data.categories;",
              "const category = items.find((item) => item.code === 'OTHER_NUISANCE');",
              "if (category) pm.environment.set('category_id', category.id);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": "{{base_url}}/api/v1/admin/categories"
          }
        },
        {
          "name": "Set Category Department Mapping",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{department_id}}\"\n}" },
            "url": "{{base_url}}/api/v1/admin/categories/{{category_id}}/department-mapping"
          }
        },
        {
          "name": "Create Department Account",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Department Account is created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.environment.set('department_account_user_id', body.data.account.user.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"departmentId\": \"{{department_id}}\",\n  \"email\": \"{{department_account_email}}\",\n  \"password\": \"{{department_account_password}}\",\n  \"displayName\": \"Planning Branch Account\"\n}" },
            "url": "{{base_url}}/api/v1/admin/department-accounts"
          }
        },
        {
          "name": "List Department Accounts",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Department Accounts are returned', () => pm.response.to.have.status(200));",
              "const accounts = pm.response.json().data.accounts;",
              "const account = accounts.find((item) => item.user && item.user.email === pm.environment.get('department_account_email'));",
              "if (account) pm.environment.set('department_account_user_id', account.userId);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": "{{base_url}}/api/v1/admin/department-accounts"
          }
        },
        {
          "name": "Deactivate Department Account",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Department Account is deactivated', () => pm.response.to.have.status(204));"
            ] }
          }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}" },
            "url": "{{base_url}}/api/v1/admin/department-accounts/{{department_account_user_id}}/status"
          }
        }
      ]
    },
    {
      "name": "Complaint Management",
      "item": [
        {
          "name": "Citizen Login for Complaints",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Citizen login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.environment.set('access_token', body.data.tokens.accessToken);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "List Active Complaint Categories",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Active categories are returned', () => pm.response.to.have.status(200));",
              "const categories = pm.response.json().data.categories;",
              "if (!pm.environment.get('category_id') && categories.length) pm.environment.set('category_id', categories[0].id);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints/categories"
          }
        },
        {
          "name": "Submit Complaint",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Complaint is created', () => pm.response.to.have.status(201));",
              "const complaint = pm.response.json().data.complaint;",
              "pm.environment.set('complaint_id', complaint.id);",
              "pm.environment.set('complaint_version', complaint.version);",
              "pm.environment.set('complaint_reference', complaint.referenceNumber);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Blocked roadside drain\",\n  \"description\": \"The roadside drainage channel is blocked and has overflowed for several days.\",\n  \"categoryId\": \"{{category_id}}\"\n}" },
            "url": "{{base_url}}/api/v1/complaints"
          }
        },
        {
          "name": "List My Complaints",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Citizen complaints are returned', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.pagination.page).to.eql(1);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints?page=1&pageSize=20&sortBy=createdAt&sortOrder=desc"
          }
        },
        {
          "name": "Get Complaint Details",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Complaint details are returned', () => pm.response.to.have.status(200));",
              "pm.environment.set('complaint_version', pm.response.json().data.complaint.version);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}"
          }
        },
        {
          "name": "Edit Submitted Complaint",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Complaint content is updated', () => pm.response.to.have.status(200));",
              "pm.environment.set('complaint_version', pm.response.json().data.complaint.version);"
            ] }
          }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Blocked roadside drainage channel\",\n  \"version\": {{complaint_version}}\n}" },
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}"
          }
        },
        {
          "name": "Upload Complaint Attachment",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Attachment is accepted', () => pm.response.to.have.status(201));",
              "pm.environment.set('attachment_id', pm.response.json().data.attachment.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/pdf" },
              { "key": "X-Filename", "value": "{{attachment_filename}}" }
            ],
            "body": { "mode": "file", "file": { "src": "" } },
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}/attachments"
          }
        },
        {
          "name": "List Complaint Attachments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}/attachments"
          }
        },
        {
          "name": "Department Login for Complaints",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Department login succeeds', () => pm.response.to.have.status(200));",
              "pm.environment.set('department_access_token', pm.response.json().data.tokens.accessToken);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{department_account_email}}\",\n  \"password\": \"{{department_account_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "List Assigned Department Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{department_access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints?page=1&pageSize=20"
          }
        },
        {
          "name": "Move Complaint to Under Review",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status transition succeeds', () => pm.response.to.have.status(200));",
              "pm.environment.set('complaint_version', pm.response.json().data.complaint.version);"
            ] }
          }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{department_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"UNDER_REVIEW\",\n  \"version\": {{complaint_version}}\n}" },
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}/status"
          }
        },
        {
          "name": "Get Complaint History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}/history"
          }
        },
        {
          "name": "Reject Citizen Status Change",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Citizen status change is forbidden', () => pm.response.to.have.status(403));"
            ] }
          }],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"version\": {{complaint_version}}\n}" },
            "url": "{{base_url}}/api/v1/complaints/{{complaint_id}}/status"
          }
        },
        {
          "name": "Administrator Search Complaints",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": "{{base_url}}/api/v1/complaints?search={{complaint_reference}}&page=1&pageSize=20"
          }
        }
      ]
    },
    {
      "name": "API Gateway Integration",
      "item": [
        {
          "name": "API Version Discovery",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Versioned gateway responds', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.version).to.eql('v1');",
              "pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string');"
            ] }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1"
          }
        },
        {
          "name": "Administrator Login for Gateway",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.data.user.role).to.eql('ADMINISTRATOR');",
              "pm.environment.set('admin_access_token', body.data.tokens.accessToken);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Administrator Integration Status",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Integration status responds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json().data;",
              "pm.expect(['ready', 'configuration_required', 'degraded']).to.include(body.status);",
              "pm.expect(body.integrations.map((item) => item.service)).to.have.members(['ai-classifier', 'rag']);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_access_token}}" },
              { "key": "X-Request-ID", "value": "postman-phase9-integration" }
            ],
            "url": "{{base_url}}/api/v1/system/integrations"
          }
        },
        {
          "name": "Citizen Login for Gateway Denial",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Citizen login succeeds', () => pm.response.to.have.status(200));",
              "pm.environment.set('access_token', pm.response.json().data.tokens.accessToken);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Reject Citizen Integration Status",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Citizen is forbidden', () => pm.response.to.have.status(403));"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/v1/system/integrations"
          }
        },
        {
          "name": "Reject Unauthenticated Integration Status",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Authentication is required', () => pm.response.to.have.status(401));"
            ] }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/system/integrations"
          }
        },
        {
          "name": "Structured Unknown Route Error",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Unknown route is structured', () => pm.response.to.have.status(404));",
              "pm.expect(pm.response.json().error.code).to.eql('ROUTE_NOT_FOUND');"
            ] }
          }],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/not-a-real-route"
          }
        }
      ]
    }
  ]
}

