{
  "name": "smart-urban-council-complaint-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted GIS-based platform for smart citizen services and digital governance.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
