{
  "name": "@sucms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "jose": "^6.2.17",
    "mysql2": "^3.15.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
